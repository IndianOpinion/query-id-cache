{
    "name": "indianopinion/query-id-cache",
    "description": "WordPress plugin that caches the ordered post ID lists and found-rows counts of expensive secondary WP_Query runs for anonymous visitors, with publish-aware invalidation.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "wp_query",
        "cache",
        "performance",
        "posts_pre_query"
    ],
    "homepage": "https://github.com/IndianOpinion/query-id-cache",
    "support": {
        "issues": "https://github.com/IndianOpinion/query-id-cache/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\QueryIdCache\\": "src/"
        },
        "files": [
            "src/functions.php"
        ],
        "exclude-from-classmap": [
            "src/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\QueryIdCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
